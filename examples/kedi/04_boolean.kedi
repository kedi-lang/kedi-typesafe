from typing import Annotated
from kedi.typesafe import BooleanCriteria
Urgency = Annotated[
    bool,
    "Does this need immediate intervention?",
    BooleanCriteria(
        true="Service is unavailable",
        false="Service is usable, or harm is not established",
    ),
]
